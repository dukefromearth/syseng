{
  "nodes": [
    {
      "id": "purpose",
      "type": "ModelPurpose",
      "properties": {
        "name": "Architectural Metamodel v1.0",
        "description": "A technology-independent architecture for learning and executing transformations of digital experiences while preserving correctness and real-time performance. Three independently extensible ontologies are connected by fixed semantic relationships; do not prematurely choose components.",
        "section": "Purpose",
        "order": 0,
        "status": "definition"
      }
    },
    {
      "id": "experience",
      "type": "DomainConcept",
      "properties": {
        "name": "Experience",
        "description": "Evolving state over time and interaction, expressed through representations.",
        "section": "Domain",
        "order": 1,
        "status": "definition"
      }
    },
    {
      "id": "representation",
      "type": "DomainConcept",
      "properties": {
        "name": "Representation",
        "description": "Describes an experience at some level of abstraction.",
        "section": "Domain",
        "order": 2,
        "status": "definition"
      }
    },
    {
      "id": "production",
      "type": "DomainConcept",
      "properties": {
        "name": "Production",
        "description": "Transforms information toward presentation; consumes and produces representations. Production may be a graph, not a line.",
        "section": "Domain",
        "order": 3,
        "status": "definition"
      }
    },
    {
      "id": "presentation",
      "type": "DomainConcept",
      "properties": {
        "name": "Presentation",
        "description": "A perceptible result that realizes an experience.",
        "section": "Domain",
        "order": 4,
        "status": "definition"
      }
    },
    {
      "id": "objective",
      "type": "DomainConcept",
      "properties": {
        "name": "Objective",
        "description": "A desired change that constrains an intervention.",
        "section": "Domain",
        "order": 5,
        "status": "definition"
      }
    },
    {
      "id": "intervention",
      "type": "DomainConcept",
      "properties": {
        "name": "Intervention",
        "description": "Modifies information or production.",
        "section": "Domain",
        "order": 6,
        "status": "definition"
      }
    },
    {
      "id": "counterfactual",
      "type": "DomainConcept",
      "properties": {
        "name": "Counterfactual",
        "description": "Alternative outcomes under controlled conditions, enabling comparable experiences.",
        "section": "Domain",
        "order": 7,
        "status": "definition"
      }
    },
    {
      "id": "evidence",
      "type": "DomainConcept",
      "properties": {
        "name": "Evidence",
        "description": "Observations with provenance that support evaluation.",
        "section": "Domain",
        "order": 8,
        "status": "definition"
      }
    },
    {
      "id": "policy",
      "type": "DomainConcept",
      "properties": {
        "name": "Policy",
        "description": "A reusable intervention rule that selects interventions.",
        "section": "Domain",
        "order": 9,
        "status": "definition"
      }
    },
    {
      "id": "causal",
      "type": "Invariant",
      "properties": {
        "name": "Causal correspondence",
        "description": "Known shared conditions and controlled differences make outcomes comparable.",
        "section": "Domain",
        "order": 10,
        "status": "requirement"
      }
    },
    {
      "id": "provenance",
      "type": "Invariant",
      "properties": {
        "name": "Provenance",
        "description": "Preserve the origin and interpretation of observations.",
        "section": "Domain",
        "order": 11,
        "status": "requirement"
      }
    },
    {
      "id": "semantic",
      "type": "Invariant",
      "properties": {
        "name": "Semantic preservation",
        "description": "Preserve the properties required by the objective.",
        "section": "Domain",
        "order": 12,
        "status": "requirement"
      }
    },
    {
      "id": "integrity",
      "type": "Invariant",
      "properties": {
        "name": "Presentation integrity",
        "description": "Prohibit exposure to the original content IF strict prevention is required; this is a conditional requirement.",
        "section": "Domain",
        "order": 13,
        "status": "requirement"
      }
    },
    {
      "id": "performance",
      "type": "Invariant",
      "properties": {
        "name": "Performance",
        "description": "Latency and throughput are parameterized requirements. 120 FPS implies an approximately 8.33 ms frame interval, not a universal limit or automatically the entire intervention budget.",
        "section": "Domain",
        "order": 14,
        "status": "requirement"
      }
    },
    {
      "id": "S1",
      "type": "System",
      "properties": {
        "name": "S1 \u00b7 Counterfactual Experimentation",
        "description": "Owns a responsibility, not the definition of any domain concept.",
        "section": "Systems",
        "order": 15,
        "status": "definition"
      }
    },
    {
      "id": "S1-responsibility",
      "type": "Responsibility",
      "properties": {
        "name": "Counterfactual Experimentation responsibility",
        "description": "Produces comparable alternative experiences; research path.",
        "section": "Systems",
        "order": 16,
        "status": "definition"
      }
    },
    {
      "id": "S1-contract",
      "type": "Contract",
      "properties": {
        "name": "Counterfactual Experimentation contract",
