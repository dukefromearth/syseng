    {
      "id": "example-objective",
      "type": "Objective",
      "properties": {
        "name": "Blood \u2192 glitter at 120 FPS",
        "description": "Replace blood with glitter while preserving other scene properties, targeting 120 FPS. The frame interval is approximately 8.33 ms; available intervention latency must be derived from the actual environment. No measurements have been completed.",
        "section": "Example",
        "order": 44,
        "status": "requirement"
      }
    },
    {
      "id": "targeting",
      "type": "Capability",
      "properties": {
        "name": "Specific target identification",
        "description": "Identify the intended blood content with enough specificity to avoid unrelated changes. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 45,
        "status": "unknown"
      }
    },
    {
      "id": "modification",
      "type": "Capability",
      "properties": {
        "name": "Controlled modification",
        "description": "Modify the target information or operations into the intended glitter result. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 46,
        "status": "unknown"
      }
    },
    {
      "id": "preservation",
      "type": "Capability",
      "properties": {
        "name": "Preservation observation",
        "description": "Observe and establish that all required other scene properties remain preserved. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 47,
        "status": "unknown"
      }
    },
    {
      "id": "timing",
      "type": "Capability",
      "properties": {
        "name": "Latency and throughput measurement",
        "description": "Measure the complete intervention and presentation path against the allocated budget. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 48,
        "status": "unknown"
      }
    },
    {
      "id": "recognition",
      "type": "Capability",
      "properties": {
        "name": "Pixel content recognition",
        "description": "Recognize intended content where intrinsic object identity is absent. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 49,
        "status": "unknown"
      }
    },
    {
      "id": "exposure",
      "type": "Capability",
      "properties": {
        "name": "Exposure prevention observation and control",
        "description": "Check and prevent original-content exposure when strict prevention is required. Required capability; actual availability is unknown.",
        "section": "Example",
        "order": 50,
        "status": "unknown"
      }
    },
    {
      "id": "engine-binding",
      "type": "Binding",
      "properties": {
        "name": "Engine candidate binding",
        "description": "May modify identified materials/effects if targeting, preservation and performance are demonstrated. Unverified candidate: no completed measurements, conformance proof or capability-availability evidence.",
        "section": "Example",
        "order": 51,
        "status": "candidate"
      }
    },
    {
      "id": "graphics-binding",
      "type": "Binding",
      "properties": {
        "name": "Graphics API candidate binding",
        "description": "May substitute resources or operations only if specific enough to preserve the contract. Unverified candidate: no completed measurements, conformance proof or capability-availability evidence.",
        "section": "Example",
        "order": 52,
        "status": "candidate"
      }
    },
    {
      "id": "compositor-binding",
      "type": "Binding",
      "properties": {
        "name": "Compositor candidate binding",
        "description": "May alter pixels, but lacks intrinsic object identity; requires recognition and latency/exposure checks. Unverified candidate: no completed measurements, conformance proof or capability-availability evidence.",
        "section": "Example",
        "order": 53,
        "status": "candidate"
      }
    },
    {
      "id": "capability-relation",
      "type": "SemanticRule",
      "properties": {
        "name": "Boundary provides capability",
        "description": "The provides relation means an interaction boundary supports a capability. No candidate boundary is asserted to provide a capability until availability is established.",
        "section": "Governance",
        "order": 54,
        "status": "definition"
      }
    },
    {
      "id": "validity",
      "type": "SemanticRule",
      "properties": {
        "name": "Binding validity",
        "description": "Valid(B,C,I) iff B models C and B models I. A declared satisfies edge expresses an attempt to fulfill a contract, NOT proof; preserves expresses an obligation, not demonstrated preservation.",
        "section": "Governance",
        "order": 55,
        "status": "requirement"
      }
    },
    {
      "id": "domain-independence",
      "type": "Guardrail",
      "properties": {
        "name": "Domain independence",
        "description": "Domain concepts and invariants are independent of technologies and system decomposition.",
        "section": "Governance",
        "order": 56,
        "status": "requirement"
      }
    },
    {
      "id": "system-independence",
      "type": "Guardrail",
      "properties": {
        "name": "System independence",
        "description": "A system is defined by responsibility, not its implementation method.",
        "section": "Governance",
        "order": 57,
        "status": "requirement"
      }
    },
    {
      "id": "capability-selection",
      "type": "Guardrail",
      "properties": {
        "name": "Capability-based realization",
        "description": "Select realizations by capabilities, not assumed interface equivalence. Unreal Engine is not literally a substitute for a Vulkan interface; bindings may fulfill the same higher contract only when capabilities are sufficient.",
        "section": "Governance",
        "order": 58,
        "status": "requirement"
      }
    },
    {
      "id": "joint-sufficiency",
      "type": "Guardrail",
      "properties": {
        "name": "Joint observation and control sufficiency",
        "description": "Observation and control capabilities must jointly suffice for the applicable contract and invariants.",
        "section": "Governance",
        "order": 59,
        "status": "requirement"
      }
    },
    {
      "id": "substitutability",
      "type": "Guardrail",
      "properties": {
        "name": "Semantic substitutability",
        "description": "Substitution requires the same contract to remain preserved, not merely similar outputs or interchangeable technology names.",
        "section": "Governance",
        "order": 60,
        "status": "requirement"
      }
    },
    {
      "id": "unsupported",
      "type": "Guardrail",
      "properties": {
        "name": "Report unsupported requirements",
        "description": "Report unsupported requirements rather than weakening the contract.",
        "section": "Governance",
        "order": 61,
        "status": "requirement"
      }
    },
    {
      "id": "result-flow",
      "type": "SemanticRule",
      "properties": {
        "name": "Resulting architecture flow",
        "description": "Domain meaning and invariants \u2192 system responsibilities and contracts \u2192 realization bindings \u2192 behavior subject to verification. This model does not claim that candidate behavior is already verified.",
        "section": "Governance",
        "order": 62,
        "status": "requirement"
      }
    }
