        "section": "Realization",
        "order": 30,
        "status": "definition"
      }
    },
    {
      "id": "binding-concept",
      "type": "RealizationConcept",
      "properties": {
        "name": "Binding",
        "description": "Connects a contract to sufficient capabilities and may use multiple boundaries.",
        "section": "Realization",
        "order": 31,
        "status": "definition"
      }
    },
    {
      "id": "L1",
      "type": "AbstractionLayer",
      "properties": {
        "name": "L1 \u00b7 State and semantics",
