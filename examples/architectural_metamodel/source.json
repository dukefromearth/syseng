        "section": "Systems",
        "order": 25,
        "status": "definition"
      }
    },
    {
      "id": "S4-contract",
      "type": "Contract",
      "properties": {
        "name": "Preference Management contract",
        "description": "Stable technology-independent objectives.",
        "section": "Systems",
        "order": 26,
        "status": "requirement"
      }
    },
    {
      "id": "environment-concept",
      "type": "RealizationConcept",
      "properties": {
        "name": "Environment",
        "description": "A computational or physical producer of experiences.",
        "section": "Realization",
        "order": 27,
        "status": "definition"
      }
    },
    {
      "id": "layer-concept",
      "type": "RealizationConcept",
      "properties": {
        "name": "Abstraction Layer",
        "description": "Classification by information and operations; layers are NOT a sequential pipeline.",
        "section": "Realization",
        "order": 28,
        "status": "definition"
      }
    },
    {
      "id": "boundary-concept",
      "type": "RealizationConcept",
      "properties": {
        "name": "Interaction Boundary",
        "description": "An observation and control point; an environment may expose some, multiple, or no relevant boundaries.",
        "section": "Realization",
        "order": 29,
        "status": "definition"
      }
    },
    {
      "id": "capability-concept",
      "type": "RealizationConcept",
      "properties": {
        "name": "Capability",
