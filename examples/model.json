{
  "schema": {
    "version": "1.0",
    "node_types": {
      "Capability": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "Boundary": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "Binding": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "Contract": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "requirements"
        ],
        "additionalProperties": false
      },
      "System": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "implements": {
        "source": [
          "Binding"
        ],
        "target": [
          "Contract"
        ],
        "impact": "target_to_source",
        "cardinality": {
          "out_min": 1
        }
      },
      "realizes": {
        "source": [
          "Capability"
        ],
        "target": [
          "Binding"
        ],
        "impact": "target_to_source"
      },
      "offers": {
        "source": [
          "System"
        ],
        "target": [
          "Capability"
        ],
        "impact": "target_to_source"
      },
      "contains": {
        "source": [
          "Boundary"
        ],
        "target": [
          "System"
        ],
        "impact": "target_to_source"
      }
    },
    "invariants": [
      {
        "kind": "unique",
        "node_type": "Contract",
        "property": "name"
      }
    ],
    "interceptors": [
      {
        "id": "contract-review",
        "target_type": "Binding",
        "handler": "pending",
        "version": "1",
        "trigger": "dependency_changed",
        "evidence_required": [
          "contract-conformance"
        ]
      }
    ]
  },
  "nodes": [
    {
      "id": "payments",
      "type": "Boundary",
      "properties": {
        "name": "Payments boundary",
        "description": "## Responsibility\nThe payments boundary owns authorization policy and communicates with external payment providers through the gateway binding.\n\nPersonal payment data must not appear in application logs."
      }
    },
    {
      "id": "checkout",
      "type": "System",
      "properties": {
        "name": "Checkout service",
        "description": "The checkout service exposes the authorization capability to the purchase workflow.\n\n### Operational behavior\n- Reject incomplete authorization requests before calling the provider.\n- Return a stable correlation identifier for support and audit."
      }
    },
    {
      "id": "authorize",
      "type": "Capability",
      "properties": {
        "name": "Authorize a payment",
        "description": "Authorize a payment without creating duplicate charges.\n\nThe caller supplies a unique **idempotency key** for each purchase attempt. Repeated calls with the same key must return the original outcome."
      }
    },
    {
      "id": "gateway",
      "type": "Binding",
      "properties": {
        "name": "Gateway adapter",
        "description": "Translate the authorization contract into the provider protocol.\n\nRetries preserve the original idempotency key; timeouts are reported as an unknown outcome until reconciliation completes."
      }
    },
    {
      "id": "authorization-contract",
      "type": "Contract",
      "properties": {
        "name": "Authorization contract",
        "requirements": [
          "Idempotency key is required",
          "No duplicate authorization on retry"
        ],
        "description": "This contract governs authorization behavior at the provider boundary. The required guarantees are declared once in the requirements property below.\n\n### Review evidence\nA contract-conformance assessment must link to the repeat-request and timeout-recovery evidence."
      }
    }
  ],
  "edges": [
    {
      "id": "gateway-contract",
      "type": "implements",
      "source": "gateway",
      "target": "authorization-contract"
    },
    {
      "id": "authorize-gateway",
      "type": "realizes",
      "source": "authorize",
      "target": "gateway"
    },
    {
      "id": "checkout-authorize",
      "type": "offers",
      "source": "checkout",
      "target": "authorize"
    },
    {
      "id": "payments-checkout",
      "type": "contains",
      "source": "payments",
      "target": "checkout"
    }
  ]
}
